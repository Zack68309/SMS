# Copy to .env and fill in. Never commit .env.

# Nalo SMS API
SMS_API_KEY=your-nalo-api-key-here
SMS_API_URL=https://sms.nalosolutions.com/smsbackend/Resl_Nalo/send-message/
# Comma-separated sender IDs shown in the dropdown (must be registered on the account)
SENDER_IDS=Test

# Public base URL Nalo posts delivery reports to, e.g. https://my-app.onrender.com
# Leave empty to use whatever URL you open the app on (works through a tunnel automatically).
CALLBACK_BASE_URL=

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Optional overrides (defaults already allow localhost, trycloudflare, ngrok and onrender)
# ALLOWED_HOSTS=localhost,127.0.0.1,my-app.example.com
# CSRF_TRUSTED_ORIGINS=https://my-app.example.com

# Optional: use Postgres (e.g. free Neon/Supabase) instead of SQLite
# DATABASE_URL=postgres://user:password@host:5432/dbname
